# ─────────────────────────────────────────────────────────────────────
# LOCK N ROLL frontend env
# Copy to .env.local and fill in values. .env.local is gitignored.
# All vars are NEXT_PUBLIC_ since they ship to the client bundle —
# do NOT add server-only secrets here.
# ─────────────────────────────────────────────────────────────────────

# Default network for first paint. User can toggle in the header.
NEXT_PUBLIC_NETWORK=devnet

# RPC endpoints. Replace with Helius / QuickNode keys for production.
NEXT_PUBLIC_DEVNET_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_MAINNET_RPC_URL=https://api.mainnet-beta.solana.com

# LOCK N ROLL on-chain program — fill in after `anchor deploy`.
# Leave empty until B0 spike passes and program is deployed.
# NEXT_PUBLIC_LOCK_N_ROLL_DEVNET_ID=
# NEXT_PUBLIC_LOCK_N_ROLL_MAINNET_ID=

# Streamflow program IDs (fixed, see design-document.md §6.1).
NEXT_PUBLIC_STREAMFLOW_DEVNET_ID=HqDGZjaVRXJ9MGRQEw7qDc2rAr6iH1n1kAQdCZaCMfMZ
NEXT_PUBLIC_STREAMFLOW_MAINNET_ID=strmRqUCoQUgGUan5YhzUZa6KqdzwX5L6FpUxfmKg5m

# Canonical USDC mint per network.
# Devnet USDC: Circle's official Devnet mint.
NEXT_PUBLIC_USDC_DEVNET_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
NEXT_PUBLIC_USDC_MAINNET_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# Pinned Streamflow Contract version expected at runtime.
# CAPTURE THIS FROM B0 SPIKE BEFORE production decode logic merges.
NEXT_PUBLIC_EXPECTED_STREAMFLOW_VERSION=2
