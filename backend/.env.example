# Backend runtime config
NODE_ENV=development
PORT=8080
HOST=0.0.0.0

# Network selection — drives shared/env.ts lookup
NETWORK=devnet

# PostgreSQL
DATABASE_URL=postgres://lnr:lnr@localhost:5433/lock_n_roll

# Helius webhook (for indexer; secret shared with Helius dashboard)
HELIUS_WEBHOOK_SECRET=replace-me-with-a-long-random-string

# Solana RPC override (optional — falls back to ENV[NETWORK].RPC_URL)
RPC_URL=
